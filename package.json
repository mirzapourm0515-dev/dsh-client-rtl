    "dsh",
    "deepseek-harness",
    "rtl",
    "right-to-left",
    "persian",
    "farsi",
    "arabic",
    "hebrew",
    "i18n",
    "client-plugin"
  ],
  "license": "MIT",
  "author": "Meysam Mirzapour",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OWNER/dsh-client-rtl.git"
  },
  "bugs": {
    "url": "https://github.com/OWNER/dsh-client-rtl/issues"
  },
  "homepage": "https://github.com/OWNER/dsh-client-rtl#readme",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "scripts": {
    "check": "node --check client.js && node --check index.js",
